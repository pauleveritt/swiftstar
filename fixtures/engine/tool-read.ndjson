{"kind": "event", "event": {"schema_version": 1, "session_id": "5a3a8f2e90da48eb854cd1fe8855f1c5", "seq": 18, "turn": 0, "elapsed_ms": 11964.640750084072, "kind": "tool_result", "op": "read", "path": "Package.swift", "result_kind": "ok", "preview": "// swift-tools-version: 6.2\nimport PackageDescription\n\n/// Settings every target this package defines shares (SU.4 spec, decisions D4\n/// and D5). Dependencies are not affected: warnings as errors applies to our\n/// own code only.\nlet common: [SwiftSetting] = [\n    .swiftLanguageMode(.v6),\n    // Xcode's \"Approachable Concurrency\" pair, enabled by name in SwiftPM.\n    .enableUpcomingFeature(\"NonisolatedNonsendingByDefault\"),\n    .enableUpcomingFeature(\"InferIsolatedConformances\"),\n    .enableUpcomingFeature(\"MemberImportVisibility\"),\n    .treatAllWarnings(as: .error),\n]\n\n/// UI, app and the tests that touch UI types run on the main actor by default.\nlet mainActor: [SwiftSetting] = common + [.defaultIsolation(MainActor.self)]\n\nlet package = Package(\n    name: \"SwiftStar\",\n    platforms: [.macOS(.v26)],\n    products: [\n        .library(name: \"SwiftStarKit\", targets: [\"SwiftStarKit\"]),\n        // Exists so Xcode generates a SwiftStarUI scheme for previews (no other consumer).\n        .library(name: \"SwiftStarUI\", targets: [\"SwiftStarUI\"]),\n        .executable(name: \"SwiftStar\", targets: [\"SwiftStar\"]),\n        // The real window over fixtures, no engine (SU.12): its own scheme.\n        .executable(name: \"SwiftStarGallery\", targets: [\"SwiftStarGallery\"]),\n    ],\n    dependencies: [\n        // Fork of Lakr233/MarkdownView (battle-tested in FlowDown), branched off\n        // the 3.9.1 revision FlowDown ships, with DS4 patches on the\n        // `ds4-patches` branch: (1) code blocks reserve their actual rendered\n        // height so they no longer overlap following text; (2) emphasis renders\n        // as italic instead of an orange underline; (3) wide tables show an\n        // auto-hiding horizontal scroller (SU.13). Pinned by revision for\n        // reproducible builds. Kept in pauleveritt/MarkdownView (forked from\n        // notatestuser/MarkdownView, 2026-10-14; nothing is pushed upstream).\n        // Upstream: https://github.com/Lakr233/MarkdownView — re-base the\n        // patches when bumping. (Provenance: ds4-control's Package.swift;\n        // facts cross, code does not.)\n        .package(\n            url: \"https://github.com/pauleveritt/MarkdownView\",\n            revision: \"645c583978b64561e207e00d27d02a53de1d633a\"),\n    ],\n    targets: [\n        .target(name: \"SwiftStarKit\", swiftSettings: common),\n        .target(\n            name: \"SwiftStarEngine\",\n            dependencies: [\"SwiftStarKit\"],\n            swiftSettings: common\n        ),\n        // The views live in a library target, not the executable: Xcode cannot\n        // preview inside an executable target of a bare package (it needs the\n        // Xcode-only ENABLE_DEBUG_DYLIB setting).\n        .target(\n            name: \"SwiftStarUI\",\n            dependencies: [\n                \"SwiftStarKit\",\n                \"SwiftStarEngine\",", "truncated": true}}
