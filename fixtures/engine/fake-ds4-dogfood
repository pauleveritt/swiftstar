#!/usr/bin/env python3
"""Fake `ds4-dogfood tui --ndjson` for integration tests (stdlib only).

`tui` mode follows ds4-engine's relay (`src/ds4_engine/ndjson_process.py`,
`Relay`) by default: a prompt while busy is queued and acked
(`{"kind":"queued","count":n}`); `stop` refuses with "no turn is running"
unless a turn is active, and is idempotent; `quit` (or stdin EOF) emits
`{"kind":"quitting"}` at once, drops any queued prompts, and actually closes
at the next natural pause if a turn is running, or at once if idle; an empty
prompt, a non-JSON line, or JSON that isn't an object are refused with the
relay's own texts. `FAKE_ENGINE_LOAD_MS` (default 0) pauses after the
fixture's own recorded "Loading model" status line, before the first
`input`; prompts sent during the gap are queued like any other busy prompt.
`FAKE_ENGINE_IGNORE_QUIT` makes quit and EOF no-ops (EOF then hangs) for the
SIGKILL-escalation test.

Env: FAKE_ENGINE_FIXTURE, FAKE_ENGINE_PACE_MS (300), FAKE_ENGINE_EXIT (0),
FAKE_ENGINE_REFUSE, FAKE_ENGINE_IGNORE_QUIT, FAKE_ENGINE_IGNORE_SIGTERM (SIG_IGN),
FAKE_ENGINE_LOAD_MS (0), FAKE_ENGINE_LOG, FAKE_ENGINE_PIDFILE (written in
every mode, including `models`), FAKE_ENGINE_ARGV_LOG (write argv, one per
line, at start).
`models --json` mode (argv[1] == "models"): prints the FAKE_ENGINE_MODELS file, or
exits 2 with "boom" when FAKE_ENGINE_MODELS_FAIL=1, or with over 5 KiB of filler then
"the real last line" when FAKE_ENGINE_MODELS_HUGE_STDERR=1, or with argparse's "invalid
choice" message when FAKE_ENGINE_MODELS_UNKNOWN=1 (or no file is set, like an older
engine); FAKE_ENGINE_MODELS_SLEEP_MS delays first.
Replays the fixture up to and including each `input` line, pausing after every
`tool_start` until a stdin line arrives or the pace elapses.
"""
import json
import os
import queue
import signal
import sys
import threading
import time

env = os.environ


def on_term(_signo, _frame):
    os._exit(130)


if env.get("FAKE_ENGINE_IGNORE_SIGTERM") == "1":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
else:
    signal.signal(signal.SIGTERM, on_term)

if env.get("FAKE_ENGINE_ARGV_LOG"):
    with open(env["FAKE_ENGINE_ARGV_LOG"], "w") as f:
        f.write("".join(a + "\n" for a in sys.argv[1:]))

if env.get("FAKE_ENGINE_PIDFILE"):
    with open(env["FAKE_ENGINE_PIDFILE"], "w") as f:
        f.write(str(os.getpid()))

if sys.argv[1:2] == ["models"]:
    time.sleep(int(env.get("FAKE_ENGINE_MODELS_SLEEP_MS", "0")) / 1000.0)
    if env.get("FAKE_ENGINE_MODELS_FAIL") == "1":
        sys.stderr.write("ds4-dogfood: error: boom\n")
        sys.stderr.flush()
        sys.exit(2)
    if env.get("FAKE_ENGINE_MODELS_HUGE_STDERR") == "1":
        sys.stderr.write("x" * 5000 + "\n")
        sys.stderr.write("the real last line\n")
        sys.stderr.flush()
        sys.exit(2)
    if env.get("FAKE_ENGINE_MODELS_UNKNOWN") == "1" or not env.get("FAKE_ENGINE_MODELS"):
        sys.stderr.write(
            "usage: ds4-dogfood [-h] [--version]\n"
            "                   [{run,audit,report,session,tui,sessions,apply,export,suite,suite-grade}]\n"
            "ds4-dogfood: error: argument command: invalid choice: 'models' "
            "(choose from run, audit, report, session, tui, sessions, apply, export, suite, suite-grade)\n")
        sys.stderr.flush()
        sys.exit(2)
    with open(env["FAKE_ENGINE_MODELS"]) as f:
        sys.stdout.write(f.read())
    sys.exit(0)

if env.get("FAKE_ENGINE_REFUSE") == "1":
    sys.stderr.write("ds4-dogfood tui: error: no model on this Mac\n")
    sys.stderr.flush()
    sys.exit(2)

pace = int(env.get("FAKE_ENGINE_PACE_MS", "300")) / 1000.0
exit_code = int(env.get("FAKE_ENGINE_EXIT", "0"))
ignore_quit = env.get("FAKE_ENGINE_IGNORE_QUIT") == "1"
load_ms = int(env.get("FAKE_ENGINE_LOAD_MS", "0"))
log_path = env.get("FAKE_ENGINE_LOG")
with open(env["FAKE_ENGINE_FIXTURE"]) as f:
    fixture = [ln.rstrip("\n") for ln in f if ln.strip()]

inbox = queue.Queue()

# Relay-like state (mirrors ds4_engine.ndjson_process.Relay).
accepting = False
quitting = False
stop_requested = False
turn_running = False
pending = []


def log(text):
    if log_path:
        with open(log_path, "a") as f:
            f.write(text + "\n")


def handle_line(raw):
    text = raw.decode("utf-8", "replace")
    if not text.strip():
        return
    log(text)
    try:
        parsed = json.loads(text)
    except ValueError:
        inbox.put(("_not_json", None))
        return
    if not isinstance(parsed, dict):
        inbox.put(("_not_object", None))
        return
    inbox.put((parsed.get("kind") or "?", text))


def reader():
    buf = b""
    fd = sys.stdin.fileno()
    while True:
        chunk = os.read(fd, 4096)
        if not chunk:
            inbox.put(("eof", None))
            return
        buf += chunk
        while True:
            # 0x03 is its own message; newline ends a JSON line.
            positions = [p for p in (buf.find(b"\n"), buf.find(b"\x03")) if p >= 0]
            if not positions:
                break
            p = min(positions)
            piece, sep, buf = buf[:p], buf[p:p + 1], buf[p + 1:]
            if sep == b"\x03":
                if piece.strip():
                    handle_line(piece)
                log("<0x03>")
                inbox.put(("stop", None))
            else:
                handle_line(piece)


def emit(line):
    try:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        os._exit(0)


def is_kind(line, kind):
    try:
        return json.loads(line).get("kind") == kind
    except Exception:
        return False


def is_tool_start(line):
    try:
        obj = json.loads(line)
        return obj.get("kind") == "event" and obj["event"].get("kind") == "tool_start"
    except Exception:
        return False


def finish():
    capture = env.get("FAKE_ENGINE_CAPTURE_PATH")
    if capture:
        emit(json.dumps({"kind": "event", "event": {"kind": "closed", "capture_path": capture}}))
    emit('{"kind": "close"}')
    sys.stderr.write("Session artifacts: /tmp/fake-session\n")
    sys.stderr.flush()
    sys.exit(exit_code)


def hang():
    while True:
        time.sleep(3600)


idx = 0


def start_turn(text, announce):
    """Resumes the scripted replay; the fake does not interpret prompt text.
    `announce` is true only for a previously-queued prompt finally starting,
    which needs a synthetic `prompt` event SwiftStar did not already cause
    locally (it sent it earlier, while busy, and only got `queued` back)."""
    if announce:
        emit(json.dumps({"kind": "event", "event": {"kind": "prompt", "text": text}}))
    replay()


def reach_pause(already_emitted_input=False):
    """Called whenever the replay reaches a point ready for a new prompt:
    after the handshake, after a turn ends, or after an interrupt. Ends the
    session if quitting, delivers a queued prompt as the next turn if one
    exists, else goes idle awaiting a prompt."""
    global accepting, turn_running, stop_requested
    # Drain anything already queued (SwiftStar's quit() writes `stop` and
    # `quit` back to back; a double stop() can land two "stop"s together
    # too) *before* resetting turn_running/stop_requested below, so a
    # genuinely idempotent second `stop` still sees the turn it duplicates
    # as running and is silently dropped, not refused as if no turn
    # existed. A quit that arrived while an interrupt was still unwinding
    # must not be missed in favor of delivering a queued prompt either.
    # `handle()`'s own `if accepting: finish()` is a no-op here since
    # accepting is still false mid-transition; it only records state
    # (quitting, pending) for the checks below.
    # A message SwiftStar wrote just before this pause (a second `stop`, or
    # the `quit` half of quit()'s back-to-back stop+quit) may not have
    # reached the reader thread yet even though nothing is in the queue this
    # instant — observed as a genuine race (passes in isolation, flakes
    # under the full suite's scheduling pressure), not a one-off flake.
    # Drain whatever is already queued fast, then give one short grace
    # window for a straggler before concluding nothing more is coming.
    while True:
        try:
            drained_kind, drained_text = inbox.get_nowait()
        except queue.Empty:
            break
        handle(drained_kind, drained_text)
    try:
        drained_kind, drained_text = inbox.get(timeout=0.05)
        handle(drained_kind, drained_text)
    except queue.Empty:
        pass
    stop_requested = False
    turn_running = False
    if quitting:
        finish()
        return
    if pending:
        text = pending.pop(0)
        turn_running = True
        start_turn(text, announce=True)
        return
    accepting = True
    if not already_emitted_input:
        emit('{"kind": "input"}')


def handle(kind, text):
    """The relay's `from_frontend`, applied to one already-parsed message.
    Returns True if the caller's wait loop should stop waiting (a turn
    started or the session is ending), False to keep waiting."""
    global accepting, quitting, pending, turn_running, stop_requested
    if kind == "_not_json":
        emit('{"kind": "error", "text": "the line is not JSON"}')
        return False
    if kind == "_not_object":
        emit('{"kind": "error", "text": "the line is not a JSON object"}')
        return False
    if kind in ("quit", "eof"):
        if ignore_quit:
            if kind == "eof":
                hang()
            return False
        if quitting:
            return False
        quitting = True
        pending = []
        emit('{"kind": "quitting"}')
        if accepting:
            finish()
        return True
    if kind == "prompt":
        prompt_text = (json.loads(text).get("text") if text else None) or ""
        if not prompt_text.strip():
            emit('{"kind": "error", "text": "a prompt needs a non-empty text"}')
            return False
        if quitting:
            emit('{"kind": "error", "text": "the session is quitting"}')
            return False
        if accepting:
            accepting = False
            turn_running = True
            start_turn(prompt_text, announce=False)
            return True
        pending.append(prompt_text)
        emit(json.dumps({"kind": "queued", "count": len(pending)}))
        return False
    if kind == "stop":
        if accepting or not turn_running:
            emit('{"kind": "error", "text": "no turn is running"}')
            return False
        if stop_requested:
            return False
        stop_requested = True
        emit('{"kind": "stopping"}')
        interrupt()
        return True
    emit(json.dumps({"kind": "error", "text": "unknown kind '%s'; expected prompt, stop or quit" % kind}))
    return False


def interrupt():
    """Discard the fixture through the turn's next `input`, then fake the stop."""
    global idx
    while idx < len(fixture):
        line = fixture[idx]
        idx += 1
        if is_kind(line, "input"):
            break
    emit('{"kind": "event", "event": {"kind": "interrupted"}}')
    reach_pause()


load_gap_done = False


def load_gap():
    """The fixture's own recorded `status` line (model loading) is followed
    by a real gap before the engine is ready; a prompt sent during it is
    queued like any other busy prompt, since `accepting` is still false."""
    global load_gap_done
    load_gap_done = True
    deadline = time.monotonic() + load_ms / 1000.0
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return
        try:
            kind, text = inbox.get(timeout=remaining)
        except queue.Empty:
            return
        handle(kind, text)


def replay():
    """Emit through the next `input`, pausing after each tool_start."""
    global idx
    while idx < len(fixture):
        line = fixture[idx]
        idx += 1
        emit(line)
        if not load_gap_done and is_kind(line, "status"):
            load_gap()
        if is_kind(line, "input"):
            reach_pause(already_emitted_input=True)
            return
        if is_tool_start(line):
            while True:
                try:
                    kind, text = inbox.get(timeout=pace)
                except queue.Empty:
                    break
                if handle(kind, text):
                    return
                # else: queued ack or refusal -- keep waiting at this pause


threading.Thread(target=reader, daemon=True).start()
replay()  # handshake through the first `input`; the fixture's own `status`
# line triggers the load gap (see load_gap()) if FAKE_ENGINE_LOAD_MS is set.
while True:
    kind, text = inbox.get()
    handle(kind, text)
