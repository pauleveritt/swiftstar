#!/usr/bin/env bash
# Runs `just lint-docs` on every commit (docs/sdd.md, "Standing rules").
# Wired up by `just install-hooks`, once per clone.
set -euo pipefail

if ! command -v just >/dev/null 2>&1; then
    echo "pre-commit: 'just' not found on PATH; skipping lint-docs" >&2
    exit 0
fi
exec just lint-docs
